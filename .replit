# Replit: import this repo, add the Secret ASSEMBLYAI_API_KEY, press Run.
# Web demo only (no phone line here). With no Piper or espeak-ng, the browser's own voice speaks.
modules = ["nodejs-20"]
run = "npm install && npm start"

[env]
HOST = "0.0.0.0"
PORT = "8770"
TRUST_PROXY = "1"
# Replit's proxy hop count is unverified: if every visitor looks like one address, generous per-visitor limits keep
# judges from locking each other out. The global limits (4 at once, 2 h a day) still bound the spend.
DEMO_MAX_PER_IP = "4"
DEMO_SESSIONS_PER_IP_HOUR = "60"

[[ports]]
localPort = 8770
externalPort = 80

[deployment]
run = ["sh", "-c", "npm install && npm start"]
